# ==========================================
# DIVYA DRISHTI - ENVIRONMENT CONFIGURATION
# ==========================================

# Application
APP_ENV=production
DEMO_MODE=false
OFFLINE_MODE=false
GRAPH_BACKEND=neo4j


# ==========================================
# DATABASE
# ==========================================

DATABASE_URL=postgresql+asyncpg://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME


# ==========================================
# REDIS
# ==========================================

REDIS_URL=redis://USERNAME:PASSWORD@HOST:6379/0


# ==========================================
# JWT AUTHENTICATION
# ==========================================

JWT_SECRET=your-production-jwt-secret
JWT_ACCESS_MIN=15


# ==========================================
# NEO4J
# ==========================================

NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password


# ==========================================
# BLOCKCHAIN APIs
# ==========================================

TRONGRID_API_KEY=your-trongrid-api-key
EVM_EXPLORER_API_KEY=your-evm-explorer-api-key
BITCOIN_API_BASE=https://mempool.space/api
CHAINABUSE_API_KEY=your-chainabuse-api-key


# ==========================================
# LLM
# ==========================================

LLM_API_KEY=your-llm-api-key
LLM_MODEL=your-llm-model


# ==========================================
# TRACE ENGINE
# ==========================================

TRACE_MAX_DEPTH=6
TRACE_MAX_NODES=500
TRACE_MIN_USD=1


# ==========================================
# SWEEP DETECTION
# ==========================================

SWEEP_WINDOW_MIN=30
SWEEP_MIN_FORWARD_RATIO=0.9


# ==========================================
# BRIDGE DETECTION
# ==========================================

BRIDGE_MATCH_WINDOW_MIN=30
BRIDGE_AMOUNT_TOL=0.01